# PrepAI - Full-Stack Configuration

# ====== FRONTEND FIREBASE CONFIG ======
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_firebase_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# ====== BACKEND FIREBASE ADMIN CONFIG ======
# Get this from Firebase Console > Project Settings > Service Account
# It's a large JSON - set it as environment variable or load from file
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
REACT_APP_FIREBASE_PROJECT_ID=your_firebase_project_id

# ====== GEMINI API ======
GEMINI_API_KEY=your_gemini_api_key_from_google_ai

# ====== BACKEND CONFIG ======
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ====== JWT TOKENS ======
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# ====== PDF PARSING ======
PDF_UPLOAD_LIMIT=10mb

# ====== OPTIONAL: Cloud Storage ======
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
