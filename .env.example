# Frontend environment variables (create .env in project root)
REACT_APP_API_URL=https://project-2-jso2.onrender.com

# Firebase (optional – only needed if using Firebase features)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Razorpay Payment Gateway (required for Premium subscriptions)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Frontend: add to .env (React)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
