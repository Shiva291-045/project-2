# Firebase Configuration (required for authentication)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Optional: Anthropic API Key (for AI-powered resume analysis and richer interview feedback)
# Get your key at https://console.anthropic.com
REACT_APP_ANTHROPIC_KEY=sk-ant-...

# Optional: Judge0 API Key (for multi-language code execution)
# Get a free key at https://rapidapi.com/judge0-official/api/judge0-ce
REACT_APP_JUDGE0_KEY=your_rapidapi_key
