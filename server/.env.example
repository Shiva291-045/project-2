# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5001

# ── MongoDB ──────────────────────────────────────────────────────────
# Get free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/prepai

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=your_strong_random_jwt_secret_min_32_chars
JWT_REFRESH=your_strong_random_refresh_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ── Email (for OTP) ──────────────────────────────────────────────────
# Gmail: use App Password (not your main password)
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=PrepAI <your_email@gmail.com>

# ── Frontend URL ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Optional AI APIs ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
JUDGE0_KEY=your_rapidapi_key
