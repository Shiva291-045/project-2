# ============================================================
# PrepAI Backend — Environment Variables
# Copy this to server/.env for local development
# Set all these in Render dashboard for production
# ============================================================

NODE_ENV=development
PORT=5001

# MongoDB Atlas (required)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/prepai

# JWT
JWT_SECRET=prepai_jwt_super_secret_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ⚠️  REQUIRED: Google Gemini AI (get from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS
FRONTEND_URL=https://your-vercel-app.vercel.app

# Razorpay (optional)
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=PrepAI <noreply@prepai.com>
