# Backend environment variables (create server/.env)
NODE_ENV=development
PORT=5001

# MongoDB (required)
MONGODB_URI=mongodb://localhost:27017/prepai

# JWT (change in production!)
JWT_SECRET=prepai_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Anthropic AI (required for AI features)
ANTHROPIC_API_KEY=sk-ant-...

# Email (optional – uses Ethereal test account in dev if not set)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=PrepAI <noreply@prepai.com>

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
